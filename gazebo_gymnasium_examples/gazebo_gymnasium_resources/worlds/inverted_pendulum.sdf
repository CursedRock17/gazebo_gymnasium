<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="inverted_pendulum">
    <physics name="10ms" type="ignored">
      <!-- 10 ms physics step; run as fast as CPU allows. Agent loop throttles
           via frame_skip in the sync-gate plugin. -->
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-python-system-loader-system"
      name="gz::sim::systems::PythonSystemLoader">
      <module_name>inverted_pendulum_learner</module_name>
      <agent_name>inverted_pendulum</agent_name>
      <frame_skip>4</frame_skip>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The inverted pendulum model. Rail is positioned 0.6 m above the
         ground so the pole has room to swing through ±90° without ground
         contact. The URDF's `world` link gets resolved against this pose
         when the model is included. -->
    <model name="inverted_pendulum">
      <pose>0 0 0.6 0 0 0</pose>
      <include merge="true">
        <uri>package://gazebo_gymnasium_resources/models/inverted_pendulum</uri>
      </include>
    </model>
  </world>
</sdf>
