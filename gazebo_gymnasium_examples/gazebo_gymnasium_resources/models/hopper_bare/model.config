<?xml version="1.0"?>
<model>
  <name>hopper_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Hopper (MuJoCo-style planar monopod) geometry only — no controllers, no
    effort limits on actuated joints. The planar root is modeled the same way
    MuJoCo does it: explicit joints (forward slide, vertical slide, pitch
    hinge) between a world-pinned anchor and the torso, so observation, reset,
    and actuation all flow through the standard joint-based AgentSpec pattern.
    Forward is +Y (agents are spaced along X, so parallel hoppers never
    collide). Ground contact at the foot is required — it is the propulsion
    mechanism.
  </description>
</model>
