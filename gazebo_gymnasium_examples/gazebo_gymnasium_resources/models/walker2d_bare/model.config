<?xml version="1.0"?>
<model>
  <name>walker2d_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Walker2d (MuJoCo-style planar biped) geometry only — hopper_bare recipe
    with two legs. Planar root as joints (forward +Y), MuJoCo-style; joint
    damping + armature-emulated inertias per the porting recipe; no effort
    limits. self_collide stays false so the coplanar legs pass through each
    other (as in MuJoCo's planar walker) while both feet contact the ground.
  </description>
</model>
