<?xml version="1.0"?>
<sdf version='1.11'>
  <model name='cartpole'>
    <link name='slider'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.0085400000000000007</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0066699999999999997</iyy>
          <iyz>0</iyz>
          <izz>0.0085400000000000007</izz>
        </inertia>
      </inertial>
      <collision name='slider_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.029999999999999999 8 0.029999999999999999</size>
          </box>
        </geometry>
      </collision>
      <visual name='slider_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.029999999999999999 8 0.029999999999999999</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0.75000006 0.25 1</diffuse>
          <ambient>1 0.75000006 0.25 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='slider_to_cart' type='prismatic'>
      <pose relative_to='slider'> 0 0 0 0 0 0</pose>
      <parent>slider</parent>
      <child>cart</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-4</lower>
          <upper>4</upper>
          <effort>1000</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='cart'>
      <pose relative_to='slider_to_cart'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.0085400000000000007</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0066699999999999997</iyy>
          <iyz>0</iyz>
          <izz>0.0085400000000000007</izz>
        </inertia>
      </inertial>
      <collision name='cart_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20000000000000001 0.25 0.20000000000000001</size>
          </box>
        </geometry>
      </collision>
      <visual name='cart_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20000000000000001 0.25 0.20000000000000001</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.37500003 0.625 0.875 1</diffuse>
          <ambient>0.37500003 0.625 0.875 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='cart_to_pole' type='revolute'>
      <pose relative_to='cart'>0.12 0 0 0 0 0</pose>
      <parent>cart</parent>
      <child>pole</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>1000</effort>
          <velocity>8</velocity>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='pole'>
      <pose relative_to='cart_to_pole'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.46999999999999997 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.083629999999999996</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.083470000000000003</iyy>
          <iyz>0</iyz>
          <izz>0.00043300000000000001</izz>
        </inertia>
      </inertial>
      <collision name='pole_collision'>
        <pose>0 0 0.46999999999999997 0 0 0</pose>
        <geometry>
          <box>
            <size>0.040000000000000001 0.059999999999999998 1</size>
          </box>
        </geometry>
      </collision>
      <visual name='pole_visual'>
        <pose>0 0 0.46999999999999997 0 0 0</pose>
        <geometry>
          <box>
            <size>0.040000000000000001 0.059999999999999998 1</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.125 0.125 0.37500003 1</diffuse>
          <ambient>0.125 0.125 0.37500003 1</ambient>
        </material>
      </visual>
    </link>
    <!-- Plugins -->
    <plugin
       filename="gz-sim-joint-position-controller-system"
       name="gz::sim::systems::JointPositionController">
       <joint_name>slider_to_cart</joint_name>
    </plugin>
    <plugin
       filename="gz-sim-joint-state-publisher-system"
       name="gz::sim::systems::JointStatePublisher">
       <joint_name>slider_to_cart</joint_name>
       <joint_name>cart_to_pole</joint_name>
    </plugin>
  </model>
</sdf>
