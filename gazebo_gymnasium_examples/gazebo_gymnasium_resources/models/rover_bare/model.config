<?xml version="1.0"?>
<model>
  <name>rover_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Differential-drive rover, bare variant for the ECM backends: all plugins
    stripped (the AgentSpec drives the axle joints with velocity commands —
    that is all DiffDrive does kinematically); onboard camera kept, downsized
    to 64x64 @ 30 Hz so every frame_skip window contains a fresh frame and
    rendering cost stays low. Camera topic is rewritten per agent by the world
    builder.
  </description>
</model>
