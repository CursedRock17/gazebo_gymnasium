<?xml version="1.0"?>
<model>
  <name>reacher_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Reacher (MuJoCo-style 2-link planar arm) geometry only. The arm rotates in
    the horizontal plane about z-axis joints (gravity exerts no torque about
    them, so the arm cannot sag). The goal marker is the MuJoCo trick made
    literal: a visual-only link on two prismatic joints (target_x, target_y),
    so per-episode goal randomization flows through the ordinary
    reset_joint_state path and the goal position is part of the joint state.
  </description>
</model>
