<?xml version="1.0"?>
<sdf version="1.8">
  <model name="reacher_bare">
    <!-- 2-link arm in the horizontal plane (z-axis revolute joints), plus a
         visual-only target on two prismatic joints. No effort limits; damping
         + armature-emulated izz per the porting recipe. Arm reach 0.21 m,
         goal within +-0.14 m. -->
    <link name="base">
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="base_collision">
        <geometry><cylinder><radius>0.02</radius><length>0.02</length></cylinder></geometry></collision>
      <visual name="base_visual">
        <geometry><cylinder><radius>0.02</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
    </link>

    <joint name="joint0" type="revolute">
      <pose relative_to="base">0 0 0 0 0 0</pose>
      <parent>base</parent><child>body0</child>
      <axis><xyz>0 0 1</xyz><dynamics><damping>1.0</damping></dynamics></axis>
    </joint>
    <link name="body0">
      <pose relative_to="joint0">0 0 0 0 0 0</pose>
      <inertial><pose>0.05 0 0 0 0 0</pose><mass>0.12</mass>
        <inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.101</izz></inertia></inertial>
      <collision name="body0_collision"><pose>0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.1 0.02 0.02</size></box></geometry></collision>
      <visual name="body0_visual"><pose>0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.1 0.02 0.02</size></box></geometry>
        <material><ambient>0.375 0.625 0.875 1</ambient><diffuse>0.375 0.625 0.875 1</diffuse></material></visual>
    </link>

    <joint name="joint1" type="revolute">
      <pose relative_to="body0">0.1 0 0 0 0 0</pose>
      <parent>body0</parent><child>body1</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-3.0</lower><upper>3.0</upper></limit>
        <dynamics><damping>1.0</damping></dynamics></axis>
    </joint>
    <link name="body1">
      <pose relative_to="joint1">0 0 0 0 0 0</pose>
      <inertial><pose>0.055 0 0 0 0 0</pose><mass>0.12</mass>
        <inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.101</izz></inertia></inertial>
      <collision name="body1_collision"><pose>0.055 0 0 0 0 0</pose>
        <geometry><box><size>0.11 0.02 0.02</size></box></geometry></collision>
      <visual name="body1_visual"><pose>0.055 0 0 0 0 0</pose>
        <geometry><box><size>0.11 0.02 0.02</size></box></geometry>
        <material><ambient>0.625 0.5 0.25 1</ambient><diffuse>0.625 0.5 0.25 1</diffuse></material></visual>
    </link>

    <!-- goal marker: visual-only (never collides), positioned by two
         prismatic joints so reset randomization moves it -->
    <link name="target_anchor">
      <inertial><mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
    </link>
    <joint name="target_x" type="prismatic">
      <pose relative_to="target_anchor">0 0 0 0 0 0</pose>
      <parent>target_anchor</parent><child>t1</child>
      <axis><xyz>1 0 0</xyz>
        <limit><lower>-0.27</lower><upper>0.27</upper></limit>
        <dynamics><damping>10.0</damping></dynamics></axis>
    </joint>
    <link name="t1"><pose relative_to="target_x">0 0 0 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="target_y" type="prismatic">
      <pose relative_to="t1">0 0 0 0 0 0</pose>
      <parent>t1</parent><child>target</child>
      <axis><xyz>0 1 0</xyz>
        <limit><lower>-0.27</lower><upper>0.27</upper></limit>
        <dynamics><damping>10.0</damping></dynamics></axis>
    </joint>
    <link name="target"><pose relative_to="target_y">0 0 0 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
      <visual name="target_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
