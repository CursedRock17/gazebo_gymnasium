<?xml version="1.0"?>
<model>
  <name>half_cheetah_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    HalfCheetah (MuJoCo-style planar quadruped-half) geometry only, built per
    the porting recipe: planar root as joints (forward +Y), horizontal torso,
    back/front legs with MuJoCo joint ranges and per-joint damping, no effort
    limits. Straight-leg box approximation of the angled capsule model.
  </description>
</model>
