      <visual name='left_wheel_visual'>
        <pose>0.46452900000000003 -0.12765399999999999 -0.026499999999999999 -9.4077000000000004e-33 -8.9189099999999999e-32 2.4630199999999999e-32</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gazebo_gymnasium_resources/models/rover/assets/left_wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.220588744 0.818627477 1 1</diffuse>
          <ambient>0.220588744 0.818627477 1 1</ambient>
        </material>
      </visual>
      <collision name='left_wheel_collision'>
        <!-- Cylinder, not a sphere. The wheel link's frame has the axle along
             its local Z (see the <axis> on left_axle), which is also the axis
             an SDF <cylinder> is built around, so no extra pose is needed.
             Radius 0.035 m = the firmware's WHEEL_DIAMETER_M/2, the number
             the real rover converts m/s with; length 0.0265 m is the CAD
             wheel's own width, recovered from its inertia tensor
             (Ixx=(1/12)m(3r^2+h^2) with the CAD r=0.0343).

             This was a sphere until 2026-08-28, which gave a POINT contact
             with no resistance to yaw about it, so the chassis could slide
             and spin nearly freely: full throttle produced ground speeds of
             0.79-0.86 m/s from wheels that can only deliver 0.51, and hard
             turns flung the rover to 1.5-2.95 m/s. A cylinder's line contact
             generates the restoring moment a real tyre does.

             Friction is isotropic at 1.0, roughly rubber on a hard floor.
             The old anisotropic 1.2/0.8 split had no <fdir1>, so the two
             directions were whatever the contact frame happened to be. -->
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.0265</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>
