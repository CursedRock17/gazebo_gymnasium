<?xml version="1.0"?>
<sdf version='1.11'>
  <model name='inverted_double_pendulum'>
    <link name='rail'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>3.0000000000000001e-06</mass>
        <inertia>
          <ixx>3e-09</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3e-09</iyy>
          <iyz>0</iyz>
          <izz>3e-09</izz>
        </inertia>
      </inertial>
      <collision name='rail_fixed_joint_lump__rail_collision'>
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <geometry>
          <cylinder>
            <length>2</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='rail_fixed_joint_lump__rail_visual'>
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <geometry>
          <cylinder>
            <length>2</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
              <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name='slider' type='prismatic'>
      <pose relative_to='rail'>0 0 0 0 0 0</pose>
      <parent>rail</parent>
      <child>cart</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1</lower>
          <upper>1</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <damping>1</damping>
          <friction>0.0001</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='cart'>
      <pose relative_to='slider'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>10.471981</mass>
        <inertia>
          <ixx>0.069810000999999997</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.17453000099999999</iyy>
          <iyz>0</iyz>
          <izz>0.17453000099999999</izz>
        </inertia>
      </inertial>
      <collision name='cart_fixed_joint_lump__cart_collision'>
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <geometry>
          <cylinder>
            <length>0.20000000000000001</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='cart_fixed_joint_lump__cart_visual'>
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <geometry>
          <cylinder>
            <length>0.20000000000000001</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
              <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name='hinge' type='revolute'>
      <pose relative_to='cart'>0 0 0 0 0 0</pose>
      <parent>cart</parent>
      <child>pole</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <damping>1</damping>
          <friction>0.0001</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='pole'>
      <pose relative_to='hinge'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.29999992855001062 0 0 0</pose>
        <mass>4.1987410000000001</mass>
        <inertia>
          <ixx>0.1694200909999784</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1694200909999784</iyy>
          <iyz>0</iyz>
          <izz>0.005670001</izz>
        </inertia>
      </inertial>
      <collision name='pole_fixed_joint_lump__pole_collision'>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.59999999999999998</length>
            <radius>0.044999999999999998</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='pole_fixed_joint_lump__pole_visual'>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.59999999999999998</length>
            <radius>0.044999999999999998</radius>
          </cylinder>
        </geometry>
              <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name='hinge2' type='revolute'>
      <pose relative_to='pole'>0 0 0.59999999999999998 0 0 0</pose>
      <parent>pole</parent>
      <child>pole2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <damping>1</damping>
          <friction>0.0001</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='pole2'>
      <pose relative_to='hinge2'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.29999992855001062 0 0 0</pose>
        <mass>4.1987410000000001</mass>
        <inertia>
          <ixx>0.1694200909999784</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1694200909999784</iyy>
          <iyz>0</iyz>
          <izz>0.005670001</izz>
        </inertia>
      </inertial>
      <collision name='pole2_fixed_joint_lump__pole2_collision'>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.59999999999999998</length>
            <radius>0.044999999999999998</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='pole2_fixed_joint_lump__pole2_visual'>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.59999999999999998</length>
            <radius>0.044999999999999998</radius>
          </cylinder>
        </geometry>
              <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

<!-- Apply scalar force on the slider; gear=500 in the MJCF, applied
         in the env's apply_action before publishing. -->
    <plugin
      filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>slider</joint_name>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>slider</joint_name>
      <joint_name>hinge</joint_name>
      <joint_name>hinge2</joint_name>
    </plugin>
  </model>
</sdf>
