<?xml version="1.0"?>
<model>
  <name>inverted_pendulum</name>
  <version>1.0</version>
  <sdf version="1.8">inverted_pendulum.sdf</sdf>

  <author>
    <name>Lucas Wendland</name>
    <email>lwendlan@umd.edu</email>
  </author>

  <description>
    Inverted Pendulum: a cart on a rail with a hinged pole on top. Continuous
    action (motor force on the slider), observation is the canonical
    InvertedPendulum-v5 4-tuple [cart_pos, pole_angle, cart_vel, pole_ang_vel].
    Ported from the Gymnasium MuJoCo MJCF in models/mujoco_sources/.
  </description>
</model>
