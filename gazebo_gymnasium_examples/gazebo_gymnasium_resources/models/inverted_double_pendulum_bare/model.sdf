<?xml version="1.0"?>
<sdf version="1.8">
  <model name="inverted_double_pendulum_bare">
    <!-- Geometry only; ECM backends own actuation + sensing. Mirrors the
         cartpole_bare recipe (which is TestFixture-verified): pose chains via
         relative_to, NO <effort> on the actuated slider joint (an effort limit
         disables ECM control in this DART build), visuals on every collision
         link. Masses/lengths follow the MuJoCo InvertedDoublePendulum model:
         cart 10.471981 kg, poles 4.198741 kg x 0.6 m. -->
    <link name="slider">
      <inertial><mass>1</mass>
        <inertia><ixx>0.00854</ixx><iyy>0.00667</iyy><izz>0.00854</izz></inertia></inertial>
      <collision name="slider_collision">
        <geometry><box><size>0.03 2.4 0.03</size></box></geometry></collision>
      <visual name="slider_visual">
        <geometry><box><size>0.03 2.4 0.03</size></box></geometry>
        <material><ambient>1 0.75 0.25 1</ambient><diffuse>1 0.75 0.25 1</diffuse></material></visual>
    </link>

    <joint name="slider_to_cart" type="prismatic">
      <pose relative_to="slider">0 0 0 0 0 0</pose>
      <parent>slider</parent><child>cart</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1</lower><upper>1</upper></limit></axis>
    </joint>

    <link name="cart">
      <pose relative_to="slider_to_cart">0 0 0 0 0 0</pose>
      <inertial><mass>10.471981</mass>
        <inertia><ixx>0.0894</ixx><iyy>0.0698</iyy><izz>0.0894</izz></inertia></inertial>
      <collision name="cart_collision">
        <geometry><box><size>0.2 0.25 0.2</size></box></geometry></collision>
      <visual name="cart_visual">
        <geometry><box><size>0.2 0.25 0.2</size></box></geometry>
        <material><ambient>0.375 0.625 0.875 1</ambient><diffuse>0.375 0.625 0.875 1</diffuse></material></visual>
    </link>

    <joint name="cart_to_pole" type="revolute">
      <pose relative_to="cart">0.12 0 0 0 0 0</pose>
      <parent>cart</parent><child>pole</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>

    <link name="pole">
      <pose relative_to="cart_to_pole">0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0.3 0 0 0</pose><mass>4.198741</mass>
        <inertia><ixx>0.1259</ixx><iyy>0.1259</iyy><izz>0.0018</izz></inertia></inertial>
      <collision name="pole_collision">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><box><size>0.04 0.06 0.6</size></box></geometry></collision>
      <visual name="pole_visual">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><box><size>0.04 0.06 0.6</size></box></geometry>
        <material><ambient>0.125 0.125 0.375 1</ambient><diffuse>0.125 0.125 0.375 1</diffuse></material></visual>
    </link>

    <joint name="pole_to_pole2" type="revolute">
      <pose relative_to="pole">0 0 0.6 0 0 0</pose>
      <parent>pole</parent><child>pole2</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>

    <link name="pole2">
      <pose relative_to="pole_to_pole2">0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0.3 0 0 0</pose><mass>4.198741</mass>
        <inertia><ixx>0.1259</ixx><iyy>0.1259</iyy><izz>0.0018</izz></inertia></inertial>
      <collision name="pole2_collision">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><box><size>0.04 0.06 0.6</size></box></geometry></collision>
      <visual name="pole2_visual">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><box><size>0.04 0.06 0.6</size></box></geometry>
        <material><ambient>0.625 0.125 0.125 1</ambient><diffuse>0.625 0.125 0.125 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
