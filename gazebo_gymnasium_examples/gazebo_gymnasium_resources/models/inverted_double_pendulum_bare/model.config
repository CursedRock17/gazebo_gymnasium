<?xml version="1.0"?>
<model>
  <name>inverted_double_pendulum_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    InvertedDoublePendulum geometry only (MuJoCo-faithful masses: cart 10.47 kg,
    two 4.2 kg / 0.6 m poles) — no controllers, no effort limit on the actuated
    slider joint. Actuation and sensing are owned by the ECM backends
    (in-process / MultiAgentHarness). Spawn clear of the ground plane: force
    actuation cannot overcome ground-contact friction (see cartpole_bare).
  </description>
</model>
