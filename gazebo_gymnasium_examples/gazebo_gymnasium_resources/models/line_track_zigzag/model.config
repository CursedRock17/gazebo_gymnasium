<?xml version="1.0"?>
<model>
  <name>line_track_zigzag</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Lucas Wendland</name>
    <email>lwendlan@umd.edu</email>
  </author>

  <description>
    Closed loop with a sawtooth top edge -- repeated sharp direction reversals, a genuinely different challenge from a single-shape corner. Same visual style and scale as models/line_track/
    (0.08 m wide, 0.002 m thick) -- part of the
    track_shape_choices population-based track-shape set for line_follower
    (see docs/domain_randomization.md).
  </description>
</model>
