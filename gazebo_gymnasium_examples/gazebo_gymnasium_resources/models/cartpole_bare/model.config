<?xml version="1.0"?>
<model>
  <name>cartpole_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    CartPole geometry only — no JointController / JointStatePublisher and no
    effort limit on the slider joint. Actuation and sensing are owned by the
    world-level MultiAgentHarness plugin via the ECM. (An effort limit would
    silently disable ECM velocity control in this DART build.)
  </description>
</model>
