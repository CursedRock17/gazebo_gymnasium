<?xml version="1.0"?>
<sdf version="1.8">
  <model name="cartpole_bare">
    <!-- Geometry only. Actuation + sensing come from the world-level
         MultiAgentHarness plugin via the ECM. No JointController, no
         JointStatePublisher, and NO <effort> on slider_to_cart (an effort
         limit disables ECM velocity control in this DART build). The spawner
         adds a world-scope fixed joint pinning `slider` to the world. -->
    <link name="slider">
      <inertial><mass>1</mass>
        <inertia><ixx>0.00854</ixx><iyy>0.00667</iyy><izz>0.00854</izz></inertia></inertial>
      <collision name="slider_collision">
        <geometry><box><size>0.03 8 0.03</size></box></geometry></collision>
      <visual name="slider_visual">
        <geometry><box><size>0.03 8 0.03</size></box></geometry>
        <material><ambient>1 0.75 0.25 1</ambient><diffuse>1 0.75 0.25 1</diffuse></material></visual>
    </link>

    <joint name="slider_to_cart" type="prismatic">
      <pose relative_to="slider">0 0 0 0 0 0</pose>
      <parent>slider</parent><child>cart</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-4</lower><upper>4</upper></limit></axis>
    </joint>

    <link name="cart">
      <pose relative_to="slider_to_cart">0 0 0 0 0 0</pose>
      <inertial><mass>1</mass>
        <inertia><ixx>0.00854</ixx><iyy>0.00667</iyy><izz>0.00854</izz></inertia></inertial>
      <collision name="cart_collision">
        <geometry><box><size>0.2 0.25 0.2</size></box></geometry></collision>
      <visual name="cart_visual">
        <geometry><box><size>0.2 0.25 0.2</size></box></geometry>
        <material><ambient>0.375 0.625 0.875 1</ambient><diffuse>0.375 0.625 0.875 1</diffuse></material></visual>
    </link>

    <joint name="cart_to_pole" type="revolute">
      <pose relative_to="cart">0.12 0 0 0 0 0</pose>
      <parent>cart</parent><child>pole</child>
      <axis><xyz>1 0 0</xyz>
        <limit><effort>1000</effort><velocity>8</velocity><lower>-1e9</lower><upper>1e9</upper></limit></axis>
    </joint>

    <link name="pole">
      <pose relative_to="cart_to_pole">0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0.47 0 0 0</pose><mass>1</mass>
        <inertia><ixx>0.08363</ixx><iyy>0.08347</iyy><izz>0.000433</izz></inertia></inertial>
      <collision name="pole_collision">
        <geometry><box><size>0.04 0.06 1</size></box></geometry></collision>
      <visual name="pole_visual">
        <geometry><box><size>0.04 0.06 1</size></box></geometry>
        <material><ambient>0.125 0.125 0.375 1</ambient><diffuse>0.125 0.125 0.375 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
