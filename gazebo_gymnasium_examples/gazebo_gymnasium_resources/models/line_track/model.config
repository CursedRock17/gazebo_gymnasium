<?xml version="1.0"?>
<model>
  <name>line_track</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Lucas Wendland</name>
    <email>lwendlan@umd.edu</email>
  </author>

  <description>
    Flat black strip on the ground used as the target track for the
    line-following rover environment. Width is roughly half the rover's
    width (0.5 m); length ~12 m so episodes can run long enough for
    learning to happen. Z-height is 0.001 m so the rover doesn't bump into
    it; the strip is purely visual / vision-detected.
  </description>
</model>
