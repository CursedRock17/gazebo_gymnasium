<?xml version="1.0"?>
<model>
  <name>ant_bare</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Ant (MuJoCo quadruped) geometry only — no controllers, no effort/velocity
    limits on the 8 actuated hip/ankle joints (stripped from the raw
    mjcf2urdf-converted ant.sdf; both are conversion artifacts and, per this
    project's established DART gotcha, a nonzero effort limit silently
    disables ECM actuation). The torso link has no parent joint, so gz-sim
    treats it as an unconstrained 6-DOF free body — read via
    AgentSpec.base_obs / HarnessCore's Link API, not a joint.
  </description>
</model>
