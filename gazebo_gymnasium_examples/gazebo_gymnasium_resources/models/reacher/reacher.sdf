    <!-- Apply joint-force plugins drive joint0 and joint1 from /env/action.
         Gear = 200 in the original MJCF — the env class scales [-1, 1]
         action up by GEAR before publishing the force command. -->
    <plugin
      filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
