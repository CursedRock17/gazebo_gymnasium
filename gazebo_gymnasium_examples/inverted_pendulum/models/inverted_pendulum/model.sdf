<?xml version="1.0"?>
<sdf version="1.8">
  <model name="inverted_pendulum">

    <!-- Rail: fixed to world via rail_fixed joint below -->
    <link name="rail">
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.01042</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.21042</iyy><iyz>0</iyz>
          <izz>5.21667</izz>
        </inertia>
      </inertial>
      <collision name="rail_collision">
        <geometry><box><size>2.5 0.1 0.03</size></box></geometry>
      </collision>
      <visual name="rail_visual">
        <geometry><box><size>2.5 0.1 0.03</size></box></geometry>
        <material>
          <diffuse>0.3 0.3 0.7 1</diffuse>
          <ambient>0.3 0.3 0.7 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Fix rail to the world frame so it never moves -->
    <joint name="rail_fixed" type="fixed">
      <parent>world</parent>
      <child>rail</child>
    </joint>

    <!-- Prismatic joint: cart slides along X axis, range ±1 m -->
    <joint name="slider" type="prismatic">
      <parent>rail</parent>
      <child>cart</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1</lower>
          <upper>1</upper>
          <effort>300</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics><damping>0.1</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- Cart: block that slides along the rail -->
    <link name="cart">
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.00417</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00667</iyy><iyz>0</iyz>
          <izz>0.00417</izz>
        </inertia>
      </inertial>
      <collision name="cart_collision">
        <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
      </collision>
      <visual name="cart_visual">
        <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
        <material>
          <diffuse>0.7 0.7 0.0 1</diffuse>
          <ambient>0.7 0.7 0.0 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Revolute joint: pole swings around Y axis, mounted 5 cm above cart -->
    <joint name="hinge" type="revolute">
      <pose relative_to="cart">0 0 0.05 0 0 0</pose>
      <parent>cart</parent>
      <child>pole</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <!-- Wide limit — termination handled in env (|angle| > 0.2 rad) -->
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>0</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- Pole: the inverted pendulum rod (0.6 m capsule, CoM at z=0.3) -->
    <link name="pole">
      <pose relative_to="hinge">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.3 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <!-- Thin-rod approx at CoM: Ixx=Iyy=m*L²/12, Izz=m*r²/2 -->
          <ixx>0.00306</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00306</iyy><iyz>0</iyz>
          <izz>0.00012</izz>
        </inertia>
      </inertial>
      <collision name="pole_collision">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><capsule><radius>0.049</radius><length>0.6</length></capsule></geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><capsule><radius>0.049</radius><length>0.6</length></capsule></geometry>
        <material>
          <diffuse>0.0 0.7 0.7 1</diffuse>
          <ambient>0.0 0.7 0.7 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Force controller: /model/inverted_pendulum/joint/slider/cmd_force (gz.msgs.Double)
         gear=100, ctrl_max=3 → 300 N max; env scales action [-1,1] × 300 N -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>slider</joint_name>
      <use_force_commands>true</use_force_commands>
      <cmd_max>300</cmd_max>
      <cmd_min>-300</cmd_min>
    </plugin>

    <!-- Joint state publisher: /world/{world}/model/inverted_pendulum/joint_state -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>slider</joint_name>
      <joint_name>hinge</joint_name>
    </plugin>
  </model>
</sdf>
