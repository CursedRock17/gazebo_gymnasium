<?xml version="1.0"?>
<sdf version="1.8">
  <world name="inverted_pendulum">

    <physics name="fast" type="ignored">
      <!-- 10 ms step, unlimited real-time rate for fast training -->
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Inlined model — rail sits at z=0.3 m, pole tip reaches ~1 m -->
    <model name="inverted_pendulum">
      <pose>0 0 0.3 0 0 0</pose>

      <link name="rail">
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.01042</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>5.21042</iyy><iyz>0</iyz>
            <izz>5.21667</izz>
          </inertia>
        </inertial>
        <collision name="rail_collision">
          <geometry><box><size>2.5 0.1 0.03</size></box></geometry>
        </collision>
        <visual name="rail_visual">
          <geometry><box><size>2.5 0.1 0.03</size></box></geometry>
          <material><diffuse>0.3 0.3 0.7 1</diffuse><ambient>0.3 0.3 0.7 1</ambient></material>
        </visual>
      </link>

      <joint name="rail_fixed" type="fixed">
        <parent>world</parent>
        <child>rail</child>
      </joint>

      <joint name="slider" type="prismatic">
        <parent>rail</parent>
        <child>cart</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-1</lower><upper>1</upper><effort>300</effort><velocity>100</velocity></limit>
          <dynamics><damping>0.1</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <link name="cart">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.00417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00667</iyy><iyz>0</iyz>
            <izz>0.00417</izz>
          </inertia>
        </inertial>
        <collision name="cart_collision">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
        </collision>
        <visual name="cart_visual">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
          <material><diffuse>0.7 0.7 0.0 1</diffuse><ambient>0.7 0.7 0.0 1</ambient></material>
        </visual>
      </link>

      <joint name="hinge" type="revolute">
        <pose relative_to="cart">0 0 0.05 0 0 0</pose>
        <parent>cart</parent>
        <child>pole</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1.5708</lower><upper>1.5708</upper><effort>0</effort><velocity>100</velocity></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <link name="pole">
        <pose relative_to="hinge">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.3 0 0 0</pose>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00306</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00306</iyy><iyz>0</iyz>
            <izz>0.00012</izz>
          </inertia>
        </inertial>
        <collision name="pole_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><capsule><radius>0.049</radius><length>0.6</length></capsule></geometry>
        </collision>
        <visual name="pole_visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><capsule><radius>0.049</radius><length>0.6</length></capsule></geometry>
          <material><diffuse>0.0 0.7 0.7 1</diffuse><ambient>0.0 0.7 0.7 1</ambient></material>
        </visual>
      </link>

      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>slider</joint_name>
        <use_force_commands>true</use_force_commands>
        <cmd_max>300</cmd_max>
        <cmd_min>-300</cmd_min>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <joint_name>slider</joint_name>
        <joint_name>hinge</joint_name>
      </plugin>
    </model>

  </world>
</sdf>
