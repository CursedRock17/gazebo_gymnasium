<?xml version="1.0"?>
<sdf version="1.8">
  <world name="half_cheetah">

    <physics name="fast" type="ignored">
      <!-- 10 ms step, unlimited real-time -->
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.9 0.8 1</ambient><diffuse>0.8 0.9 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      HalfCheetah: torso at z=0.7 m (matching MuJoCo initial state).
      Total mass ≈ 14 kg (normalized from volume-computed masses).

      Joint positions in SDF are given relative to parent link.
      All joints are revolute around Y axis (out-of-plane for 2D locomotion).
      Geom poses use pitch angle from MuJoCo axisangle to orient capsules.

      Gear values (from MJCF actuators):
        bthigh=120, bshin=90, bfoot=60, fthigh=120, fshin=60, ffoot=30
    -->
    <model name="half_cheetah">
      <pose>0 0 0.7 0 0 0</pose>

      <!-- Torso: horizontal capsule (pitch=π/2), 1 m span, r=0.046
           Plus head capsule at (0.6, 0, 0.1) angled pitch=0.87 rad.
           Combined mass ≈ 6.25 kg, CoM at approximately (0.15, 0, 0.03). -->
      <link name="torso">
        <inertial>
          <pose>0.15 0 0.03 0 0 0</pose>
          <mass>6.25</mass>
          <inertia>
            <!-- Horizontal torso: Ixx(along X)=m*r²/2, Iyy=Izz=m*(3r²+L²)/12 -->
            <ixx>0.0066</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.524</iyy><iyz>0</iyz>
            <izz>0.524</izz>
          </inertia>
        </inertial>
        <!-- Torso body: horizontal capsule along X -->
        <collision name="torso_collision">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry><capsule><radius>0.046</radius><length>1.0</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="torso_visual">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry><capsule><radius>0.046</radius><length>1.0</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
        <!-- Head (angled capsule at the front) -->
        <collision name="head_collision">
          <pose>0.6 0 0.1 0 0.87 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.3</length></capsule></geometry>
        </collision>
        <visual name="head_visual">
          <pose>0.6 0 0.1 0 0.87 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.3</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
      </link>

      <!-- Back leg chain: bthigh → bshin → bfoot -->

      <joint name="bthigh" type="revolute">
        <pose relative_to="torso">-0.5 0 0 0 0 0</pose>
        <parent>torso</parent>
        <child>bthigh_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.52</lower><upper>1.05</upper><effort>120</effort><velocity>100</velocity></limit>
          <dynamics><damping>6.0</damping><stiffness>240.0</stiffness></dynamics>
        </axis>
      </joint>

      <link name="bthigh_link">
        <pose relative_to="bthigh">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.1 0 -0.13 0 0 0</pose>
          <mass>1.55</mass>
          <inertia>
            <ixx>0.01169</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01169</iyy><iyz>0</iyz>
            <izz>0.00164</izz>
          </inertia>
        </inertial>
        <collision name="bthigh_collision">
          <pose>0.1 0 -0.13 0 -3.8 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.29</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="bthigh_visual">
          <pose>0.1 0 -0.13 0 -3.8 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.29</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
      </link>

      <joint name="bshin" type="revolute">
        <pose relative_to="bthigh_link">0.16 0 -0.25 0 0 0</pose>
        <parent>bthigh_link</parent>
        <child>bshin_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.785</lower><upper>0.785</upper><effort>90</effort><velocity>100</velocity></limit>
          <dynamics><damping>4.5</damping><stiffness>180.0</stiffness></dynamics>
        </axis>
      </joint>

      <link name="bshin_link">
        <pose relative_to="bshin">0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.14 0 -0.07 0 0 0</pose>
          <mass>1.59</mass>
          <inertia>
            <ixx>0.01276</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01276</iyy><iyz>0</iyz>
            <izz>0.00168</izz>
          </inertia>
        </inertial>
        <collision name="bshin_collision">
          <pose>-0.14 0 -0.07 0 -2.03 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.30</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="bshin_visual">
          <pose>-0.14 0 -0.07 0 -2.03 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.30</length></capsule></geometry>
          <material><diffuse>0.9 0.6 0.6 1</diffuse><ambient>0.9 0.6 0.6 1</ambient></material>
        </visual>
      </link>

      <joint name="bfoot" type="revolute">
        <pose relative_to="bshin_link">-0.28 0 -0.14 0 0 0</pose>
        <parent>bshin_link</parent>
        <child>bfoot_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.4</lower><upper>0.785</upper><effort>60</effort><velocity>100</velocity></limit>
          <dynamics><damping>3.0</damping><stiffness>120.0</stiffness></dynamics>
        </axis>
      </joint>

      <link name="bfoot_link">
        <pose relative_to="bfoot">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.03 0 -0.097 0 0 0</pose>
          <mass>1.10</mass>
          <inertia>
            <ixx>0.00382</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00382</iyy><iyz>0</iyz>
            <izz>0.00116</izz>
          </inertia>
        </inertial>
        <collision name="bfoot_collision">
          <pose>0.03 0 -0.097 0 -0.27 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.188</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="bfoot_visual">
          <pose>0.03 0 -0.097 0 -0.27 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.188</length></capsule></geometry>
          <material><diffuse>0.9 0.6 0.6 1</diffuse><ambient>0.9 0.6 0.6 1</ambient></material>
        </visual>
      </link>

      <!-- Front leg chain: fthigh → fshin → ffoot -->

      <joint name="fthigh" type="revolute">
        <pose relative_to="torso">0.5 0 0 0 0 0</pose>
        <parent>torso</parent>
        <child>fthigh_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1.0</lower><upper>0.7</upper><effort>120</effort><velocity>100</velocity></limit>
          <dynamics><damping>4.5</damping><stiffness>180.0</stiffness></dynamics>
        </axis>
      </joint>

      <link name="fthigh_link">
        <pose relative_to="fthigh">0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.07 0 -0.12 0 0 0</pose>
          <mass>1.44</mass>
          <inertia>
            <ixx>0.00925</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00925</iyy><iyz>0</iyz>
            <izz>0.00152</izz>
          </inertia>
        </inertial>
        <collision name="fthigh_collision">
          <pose>-0.07 0 -0.12 0 0.52 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.266</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="fthigh_visual">
          <pose>-0.07 0 -0.12 0 0.52 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.266</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
      </link>

      <joint name="fshin" type="revolute">
        <pose relative_to="fthigh_link">-0.14 0 -0.24 0 0 0</pose>
        <parent>fthigh_link</parent>
        <child>fshin_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1.2</lower><upper>0.87</upper><effort>60</effort><velocity>100</velocity></limit>
          <dynamics><damping>3.0</damping><stiffness>120.0</stiffness></dynamics>
        </axis>
      </joint>

      <link name="fshin_link">
        <pose relative_to="fshin">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.065 0 -0.09 0 0 0</pose>
          <mass>1.20</mass>
          <inertia>
            <ixx>0.00513</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00513</iyy><iyz>0</iyz>
            <izz>0.00127</izz>
          </inertia>
        </inertial>
        <collision name="fshin_collision">
          <pose>0.065 0 -0.09 0 -0.6 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.212</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="fshin_visual">
          <pose>0.065 0 -0.09 0 -0.6 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.212</length></capsule></geometry>
          <material><diffuse>0.9 0.6 0.6 1</diffuse><ambient>0.9 0.6 0.6 1</ambient></material>
        </visual>
      </link>

      <joint name="ffoot" type="revolute">
        <pose relative_to="fshin_link">0.13 0 -0.18 0 0 0</pose>
        <parent>fshin_link</parent>
        <child>ffoot_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.5</lower><upper>0.5</upper><effort>30</effort><velocity>100</velocity></limit>
          <dynamics><damping>1.5</damping><stiffness>60.0</stiffness></dynamics>
        </axis>
      </joint>

      <link name="ffoot_link">
        <pose relative_to="ffoot">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.045 0 -0.07 0 0 0</pose>
          <mass>0.88</mass>
          <inertia>
            <ixx>0.00190</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00190</iyy><iyz>0</iyz>
            <izz>0.00093</izz>
          </inertia>
        </inertial>
        <collision name="ffoot_collision">
          <pose>0.045 0 -0.07 0 -0.6 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.14</length></capsule></geometry>
          <surface><friction><ode><mu>0.4</mu></ode></friction></surface>
        </collision>
        <visual name="ffoot_visual">
          <pose>0.045 0 -0.07 0 -0.6 0</pose>
          <geometry><capsule><radius>0.046</radius><length>0.14</length></capsule></geometry>
          <material><diffuse>0.9 0.6 0.6 1</diffuse><ambient>0.9 0.6 0.6 1</ambient></material>
        </visual>
      </link>

      <!-- Force controllers (gear values from MJCF actuators) -->
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>bthigh</joint_name><use_force_commands>true</use_force_commands>
        <cmd_max>120</cmd_max><cmd_min>-120</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>bshin</joint_name><use_force_commands>true</use_force_commands>
        <cmd_max>90</cmd_max><cmd_min>-90</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>bfoot</joint_name><use_force_commands>true</use_force_commands>
        <cmd_max>60</cmd_max><cmd_min>-60</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>fthigh</joint_name><use_force_commands>true</use_force_commands>
        <cmd_max>120</cmd_max><cmd_min>-120</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>fshin</joint_name><use_force_commands>true</use_force_commands>
        <cmd_max>60</cmd_max><cmd_min>-60</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>ffoot</joint_name><use_force_commands>true</use_force_commands>
        <cmd_max>30</cmd_max><cmd_min>-30</cmd_min>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>bthigh</joint_name>
        <joint_name>bshin</joint_name>
        <joint_name>bfoot</joint_name>
        <joint_name>fthigh</joint_name>
        <joint_name>fshin</joint_name>
        <joint_name>ffoot</joint_name>
      </plugin>
    </model>

  </world>
</sdf>
