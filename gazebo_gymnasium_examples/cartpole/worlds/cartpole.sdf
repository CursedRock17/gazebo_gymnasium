<?xml version="1.0"?>
<sdf version="1.8">
  <world name="cartpole">

    <physics name="fast" type="ignored">
      <!-- 10ms step, unlimited real-time rate for fast training -->
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- CartPole model inlined to avoid resource path configuration -->
    <model name="cartpole">
      <pose>0 0 0.10 0 0 0</pose>
      <self_collide>true</self_collide>

      <link name="slider">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.00854</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00667</iyy><iyz>0</iyz>
            <izz>0.00854</izz>
          </inertia>
        </inertial>
        <collision name="slider_collision">
          <geometry><box><size>0.03 8 0.03</size></box></geometry>
        </collision>
        <visual name="slider_visual">
          <geometry><box><size>0.03 8 0.03</size></box></geometry>
          <material><diffuse>1 0.75 0.25 1</diffuse><ambient>1 0.75 0.25 1</ambient></material>
        </visual>
      </link>

      <joint name="slider_to_cart" type="prismatic">
        <pose relative_to="slider">0 0 0 0 0 0</pose>
        <parent>slider</parent>
        <child>cart</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-4</lower><upper>4</upper><effort>1000</effort><velocity>100</velocity></limit>
          <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        </axis>
      </joint>

      <link name="cart">
        <pose relative_to="slider_to_cart">0 0 0 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.00854</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00667</iyy><iyz>0</iyz>
            <izz>0.00854</izz>
          </inertia>
        </inertial>
        <collision name="cart_collision">
          <geometry><box><size>0.2 0.25 0.2</size></box></geometry>
        </collision>
        <visual name="cart_visual">
          <geometry><box><size>0.2 0.25 0.2</size></box></geometry>
          <material><diffuse>0.375 0.625 0.875 1</diffuse><ambient>0.375 0.625 0.875 1</ambient></material>
        </visual>
      </link>

      <joint name="cart_to_pole" type="revolute">
        <pose relative_to="cart">0.12 0 0 0 0 0</pose>
        <parent>cart</parent>
        <child>pole</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper><effort>1000</effort><velocity>8</velocity></limit>
          <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        </axis>
      </joint>

      <link name="pole">
        <pose relative_to="cart_to_pole">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.47 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.08363</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.08347</iyy><iyz>0</iyz>
            <izz>0.000433</izz>
          </inertia>
        </inertial>
        <collision name="pole_collision">
          <pose>0 0 0.47 0 0 0</pose>
          <geometry><box><size>0.04 0.06 1</size></box></geometry>
        </collision>
        <visual name="pole_visual">
          <pose>0 0 0.47 0 0 0</pose>
          <geometry><box><size>0.04 0.06 1</size></box></geometry>
          <material><diffuse>0.125 0.125 0.375 1</diffuse><ambient>0.125 0.125 0.375 1</ambient></material>
        </visual>
      </link>

      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>slider_to_cart</joint_name>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <joint_name>slider_to_cart</joint_name>
        <joint_name>cart_to_pole</joint_name>
      </plugin>
    </model>

  </world>
</sdf>
