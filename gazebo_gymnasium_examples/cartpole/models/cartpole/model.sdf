<?xml version="1.0"?>
<sdf version="1.11">
  <model name="cartpole">
    <!-- Slider: the fixed rail the cart rides on -->
    <link name="slider">
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.00854</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00667</iyy><iyz>0</iyz>
          <izz>0.00854</izz>
        </inertia>
      </inertial>
      <collision name="slider_collision">
        <geometry><box><size>0.03 8 0.03</size></box></geometry>
      </collision>
      <visual name="slider_visual">
        <geometry><box><size>0.03 8 0.03</size></box></geometry>
        <material>
          <diffuse>1 0.75 0.25 1</diffuse>
          <ambient>1 0.75 0.25 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Prismatic joint: cart slides along the Y axis of the rail -->
    <joint name="slider_to_cart" type="prismatic">
      <pose relative_to="slider">0 0 0 0 0 0</pose>
      <parent>slider</parent>
      <child>cart</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-4</lower>
          <upper>4</upper>
          <effort>1000</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- Cart: the block that moves along the slider -->
    <link name="cart">
      <pose relative_to="slider_to_cart">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.00854</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00667</iyy><iyz>0</iyz>
          <izz>0.00854</izz>
        </inertia>
      </inertial>
      <collision name="cart_collision">
        <geometry><box><size>0.2 0.25 0.2</size></box></geometry>
      </collision>
      <visual name="cart_visual">
        <geometry><box><size>0.2 0.25 0.2</size></box></geometry>
        <material>
          <diffuse>0.375 0.625 0.875 1</diffuse>
          <ambient>0.375 0.625 0.875 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Revolute joint: pole swings around the X axis -->
    <joint name="cart_to_pole" type="revolute">
      <pose relative_to="cart">0.12 0 0 0 0 0</pose>
      <parent>cart</parent>
      <child>pole</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1000</effort>
          <velocity>8</velocity>
        </limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- Pole: the pendulum balanced on the cart -->
    <link name="pole">
      <pose relative_to="cart_to_pole">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.47 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.08363</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08347</iyy><iyz>0</iyz>
          <izz>0.000433</izz>
        </inertia>
      </inertial>
      <collision name="pole_collision">
        <pose>0 0 0.47 0 0 0</pose>
        <geometry><box><size>0.04 0.06 1</size></box></geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 0.47 0 0 0</pose>
        <geometry><box><size>0.04 0.06 1</size></box></geometry>
        <material>
          <diffuse>0.125 0.125 0.375 1</diffuse>
          <ambient>0.125 0.125 0.375 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Position controller: receives target position on /model/cartpole/joint/slider_to_cart/0/cmd_pos -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>slider_to_cart</joint_name>
      <!-- P=10 gives ~5 N initial force at ±0.5 m target (1 kg cart).
           Half of classic CartPole-v1 magnitude — enough to tip the pole
           without slamming the cart into the boundaries.
           D=1 damps overshoot proportionally. -->
      <p_gain>10</p_gain>
      <d_gain>1</d_gain>
      <i_gain>0</i_gain>
      <cmd_max>1000</cmd_max>
      <cmd_min>-1000</cmd_min>
    </plugin>

    <!-- Joint state publisher: publishes position+velocity on /world/{world}/model/cartpole/joint_state -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>slider_to_cart</joint_name>
      <joint_name>cart_to_pole</joint_name>
    </plugin>
  </model>
</sdf>
