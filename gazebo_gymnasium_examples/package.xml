<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_gymnasium_examples</name>
  <version>0.1.0</version>
  <description>
    Example environments using gazebo_gymnasium. Each subdirectory is a self-contained
    example: models, worlds, environment scripts, training scripts, and launch files.
  </description>
  <maintainer email="mtglucas1@gmail.com">Lucas Wendland</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_gymnasium</depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>python3-stable-baselines3</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
