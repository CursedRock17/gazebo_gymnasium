<?xml version="1.0"?>
<sdf version="1.8">
  <model name="hopper">
    <!--
      Kinematic chain (matching hopper.xml):
        torso (free-floating root)
          thigh_joint  (Y-axis hinge, -150° to 0°,  gear=200)
          thigh
            leg_joint    (Y-axis hinge, -150° to 0°, gear=200)
            leg
              foot_joint   (Y-axis hinge, -45° to 45°, gear=200)
              foot

      Link origins are placed at their parent joint positions (SDF convention).
      All masses estimated from MuJoCo capsule volumes at density=1000 kg/m³.
    -->

    <!-- Torso: vertical capsule (root — free-floating under physics) -->
    <link name="torso">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>3.67</mass>
        <inertia>
          <ixx>0.0512</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0512</iyy><iyz>0</iyz>
          <izz>0.00459</izz>
        </inertia>
      </inertial>
      <collision name="torso_collision">
        <geometry><capsule><radius>0.05</radius><length>0.4</length></capsule></geometry>
        <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
      </collision>
      <visual name="torso_visual">
        <geometry><capsule><radius>0.05</radius><length>0.4</length></capsule></geometry>
        <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
      </visual>
    </link>

    <!--
      thigh_joint: pivot at (0, 0, -0.2) in torso frame.
      MuJoCo axis="0 -1 0" (−Y) → SDF xyz="0 1 0" with flipped limits.
      Range -150° to 0° in MuJoCo (axis −Y) = 0° to 150° along +Y → lower=0, upper=2.618.
      For simplicity I'll keep the MuJoCo convention with positive axis and negate limits.
    -->
    <joint name="thigh_joint" type="revolute">
      <pose relative_to="torso">0 0 -0.2 0 0 0</pose>
      <parent>torso</parent>
      <child>thigh</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-2.618</lower>
          <upper>0</upper>
          <effort>200</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics><damping>1.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <!-- Thigh: capsule r=0.05, L=0.45, CoM 0.225 m below thigh_joint -->
    <link name="thigh">
      <pose relative_to="thigh_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.225 0 0 0</pose>
        <mass>4.06</mass>
        <inertia>
          <ixx>0.0711</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0711</iyy><iyz>0</iyz>
          <izz>0.00508</izz>
        </inertia>
      </inertial>
      <collision name="thigh_collision">
        <pose>0 0 -0.225 0 0 0</pose>
        <geometry><capsule><radius>0.05</radius><length>0.45</length></capsule></geometry>
        <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
      </collision>
      <visual name="thigh_visual">
        <pose>0 0 -0.225 0 0 0</pose>
        <geometry><capsule><radius>0.05</radius><length>0.45</length></capsule></geometry>
        <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
      </visual>
    </link>

    <!--
      leg_joint: at (0,0,-0.45) from thigh (= leg body at -0.7 + leg_joint pos +0.25 = -0.45).
    -->
    <joint name="leg_joint" type="revolute">
      <pose relative_to="thigh">0 0 -0.45 0 0 0</pose>
      <parent>thigh</parent>
      <child>leg</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-2.618</lower>
          <upper>0</upper>
          <effort>200</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics><damping>1.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <!-- Leg: capsule r=0.04, L=0.5, CoM 0.25 m below leg_joint -->
    <link name="leg">
      <pose relative_to="leg_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.25 0 0 0</pose>
        <mass>2.78</mass>
        <inertia>
          <ixx>0.0590</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0590</iyy><iyz>0</iyz>
          <izz>0.00222</izz>
        </inertia>
      </inertial>
      <collision name="leg_collision">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><capsule><radius>0.04</radius><length>0.5</length></capsule></geometry>
        <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
      </collision>
      <visual name="leg_visual">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><capsule><radius>0.04</radius><length>0.5</length></capsule></geometry>
        <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
      </visual>
    </link>

    <!--
      foot_joint: at (0, 0, -0.25) from leg.
      MuJoCo foot body at (0.13,0,-0.35) from leg body; joint at (-0.13,0,0.1) from foot body
      → joint at (0,0,-0.25) from leg body (see derivation in world SDF header).
    -->
    <joint name="foot_joint" type="revolute">
      <pose relative_to="leg">0 0 -0.25 0 0 0</pose>
      <parent>leg</parent>
      <child>foot</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.7854</lower>
          <upper>0.7854</upper>
          <effort>200</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics><damping>1.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <!--
      Foot: horizontal capsule (pitch=π/2 → along X), r=0.06, L=0.39.
      CoM at (0.065, 0, 0) from foot_joint.
      High friction for stable contact (mu=2.0 matching MuJoCo).
    -->
    <link name="foot">
      <pose relative_to="foot_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.065 0 0 0 0 0</pose>
        <mass>5.31</mass>
        <!-- Capsule horizontal: Ixx=m*r²/2, Iyy=Izz=m*(3r²+L²)/12 -->
        <inertia>
          <ixx>0.00956</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.07213</iyy><iyz>0</iyz>
          <izz>0.07213</izz>
        </inertia>
      </inertial>
      <collision name="foot_collision">
        <!-- Capsule at (0.065, 0, 0), rotated 90° around Y to lie along X -->
        <pose>0.065 0 0 0 1.5708 0</pose>
        <geometry><capsule><radius>0.06</radius><length>0.39</length></capsule></geometry>
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="foot_visual">
        <pose>0.065 0 0 0 1.5708 0</pose>
        <geometry><capsule><radius>0.06</radius><length>0.39</length></capsule></geometry>
        <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
      </visual>
    </link>

    <!-- Force controllers: /model/hopper/joint/{name}/cmd_force (gz.msgs.Double)
         env scales action [-1,1] × 200 N·m -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>thigh_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>leg_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>foot_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>

    <!-- Joint state publisher for all controlled joints -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>thigh_joint</joint_name>
      <joint_name>leg_joint</joint_name>
      <joint_name>foot_joint</joint_name>
    </plugin>
  </model>
</sdf>
