<?xml version="1.0"?>
<sdf version="1.8">
  <world name="hopper">

    <physics name="fast" type="ignored">
      <!-- 10 ms step (Hopper-v5 uses 2 ms × 4 frame_skip = 8 ms; 10 ms is close enough) -->
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.9 0.8 1</ambient><diffuse>0.8 0.9 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Hopper model: torso starts at z=1.25 m (matching MuJoCo initial state).
      All joints at 0 → hopper falls, lands, then learns to hop.
    -->
    <model name="hopper">
      <pose>0 0 1.25 0 0 0</pose>

      <link name="torso">
        <inertial>
          <mass>3.67</mass>
          <inertia>
            <ixx>0.0512</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0512</iyy><iyz>0</iyz>
            <izz>0.00459</izz>
          </inertia>
        </inertial>
        <collision name="torso_collision">
          <geometry><capsule><radius>0.05</radius><length>0.4</length></capsule></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="torso_visual">
          <geometry><capsule><radius>0.05</radius><length>0.4</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
      </link>

      <joint name="thigh_joint" type="revolute">
        <pose relative_to="torso">0 0 -0.2 0 0 0</pose>
        <parent>torso</parent>
        <child>thigh</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>-2.618</lower><upper>0</upper><effort>200</effort><velocity>100</velocity></limit>
          <dynamics><damping>1.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

      <link name="thigh">
        <pose relative_to="thigh_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 -0.225 0 0 0</pose>
          <mass>4.06</mass>
          <inertia>
            <ixx>0.0711</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0711</iyy><iyz>0</iyz>
            <izz>0.00508</izz>
          </inertia>
        </inertial>
        <collision name="thigh_collision">
          <pose>0 0 -0.225 0 0 0</pose>
          <geometry><capsule><radius>0.05</radius><length>0.45</length></capsule></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="thigh_visual">
          <pose>0 0 -0.225 0 0 0</pose>
          <geometry><capsule><radius>0.05</radius><length>0.45</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
      </link>

      <joint name="leg_joint" type="revolute">
        <pose relative_to="thigh">0 0 -0.45 0 0 0</pose>
        <parent>thigh</parent>
        <child>leg</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>-2.618</lower><upper>0</upper><effort>200</effort><velocity>100</velocity></limit>
          <dynamics><damping>1.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

      <link name="leg">
        <pose relative_to="leg_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 -0.25 0 0 0</pose>
          <mass>2.78</mass>
          <inertia>
            <ixx>0.0590</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0590</iyy><iyz>0</iyz>
            <izz>0.00222</izz>
          </inertia>
        </inertial>
        <collision name="leg_collision">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry><capsule><radius>0.04</radius><length>0.5</length></capsule></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry><capsule><radius>0.04</radius><length>0.5</length></capsule></geometry>
          <material><diffuse>0.8 0.6 0.4 1</diffuse><ambient>0.8 0.6 0.4 1</ambient></material>
        </visual>
      </link>

      <joint name="foot_joint" type="revolute">
        <pose relative_to="leg">0 0 -0.25 0 0 0</pose>
        <parent>leg</parent>
        <child>foot</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>-0.7854</lower><upper>0.7854</upper><effort>200</effort><velocity>100</velocity></limit>
          <dynamics><damping>1.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

      <link name="foot">
        <pose relative_to="foot_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.065 0 0 0 0 0</pose>
          <mass>5.31</mass>
          <inertia>
            <ixx>0.00956</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.07213</iyy><iyz>0</iyz>
            <izz>0.07213</izz>
          </inertia>
        </inertial>
        <collision name="foot_collision">
          <pose>0.065 0 0 0 1.5708 0</pose>
          <geometry><capsule><radius>0.06</radius><length>0.39</length></capsule></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="foot_visual">
          <pose>0.065 0 0 0 1.5708 0</pose>
          <geometry><capsule><radius>0.06</radius><length>0.39</length></capsule></geometry>
          <material><diffuse>0.9 0.6 0.6 1</diffuse><ambient>0.9 0.6 0.6 1</ambient></material>
        </visual>
      </link>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>thigh_joint</joint_name>
        <use_force_commands>true</use_force_commands>
        <cmd_max>200</cmd_max><cmd_min>-200</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>leg_joint</joint_name>
        <use_force_commands>true</use_force_commands>
        <cmd_max>200</cmd_max><cmd_min>-200</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>foot_joint</joint_name>
        <use_force_commands>true</use_force_commands>
        <cmd_max>200</cmd_max><cmd_min>-200</cmd_min>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>thigh_joint</joint_name>
        <joint_name>leg_joint</joint_name>
        <joint_name>foot_joint</joint_name>
      </plugin>
    </model>

  </world>
</sdf>
