<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_gymnasium_bringup</name>
  <version>0.1.0</version>
  <description>Launch files that bring up each example end-to-end: gz sim + the env's sync-gate plugin + optional Foxglove bridge + optional rosbag recording.</description>
  <maintainer email="lwendlan@umd.edu">Lucas Wendland</maintainer>
  <author email="lwendlan@umd.edu">Lucas Wendland</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_gymnasium_resources</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <!-- ComposableNodeContainer host for composable launches. -->
  <exec_depend>rclcpp_components</exec_depend>
  <!-- robot_state_publisher serves the URDF + publishes link transforms
       on /tf so Foxglove's 3D panel sees a complete TF tree. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- tf2_ros provides static_transform_publisher (root frame anchor). -->
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
