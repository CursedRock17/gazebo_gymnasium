<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_gymnasium</name>
  <version>0.1.0</version>
  <description>
    Gymnasium interface for Gazebo Sim. Provides a base GazeboEnv class that drives
    a running Gazebo simulation externally via gz.transport, compatible with any
    Gymnasium-compatible RL library.
  </description>
  <maintainer email="mtglucas1@gmail.com">Lucas Wendland</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-gymnasium</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
